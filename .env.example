# Copy to .env (never commit .env). On Hugging Face Spaces set these as Secrets / Variables instead.

# Cloud LLM for root-cause analysis and report drafting (OpenAI-compatible; Groq free plan works)
LLM_BACKEND=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b              # llama-3.3-70b-versatile was retired from Groq (Oct 2026); list GET /openai/v1/models to pick another
LLM_API_KEY=paste-your-groq-api-key-here
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2                     # retries on 429/5xx, honouring Retry-After (free-tier Groq: 8k tokens/min)
LLM_FALLBACK_MODEL=openai/gpt-oss-120b   # used when the primary model's per-day quota is exhausted (Groq TPD); empty = off

# Incident classifier
CLASSIFIER_BACKEND=finetuned          # finetuned | llm | rules
FINETUNED_MODEL=                      # e.g. rachitst/oncall-ai-qwen2.5-0.5b-incident-classifier (HF Hub) or ./models/merged
CLASSIFIER_FALLBACK=llm               # used if the fine-tuned model cannot be loaded
CLASSIFIER_MIN_CONFIDENCE=0.55

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # "hash" = offline test embedder
RAG_TOP_K=4
RAG_MAX_DISTANCE=1.6
